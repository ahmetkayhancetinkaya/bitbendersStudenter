{
  "name": "kampuskit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["frontend", "backend", "shared"],
  "engines": {"node": ">=22.17.0"},
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace @kampuskit/frontend",
    "dev:backend": "npm run dev --workspace @kampuskit/backend",
    "build": "npm run build --workspace @kampuskit/frontend && npm run build --workspace @kampuskit/backend",
    "start": "npm run start --workspace @kampuskit/backend",
    "lint": "oxlint frontend/src backend/src shared/src scripts",
    "preview": "npm run preview --workspace @kampuskit/frontend",
    "test": "npm run test --workspaces --if-present",
    "db:prepare": "npm run db:prepare --workspace @kampuskit/backend",
    "seed:examples": "npm run seed:examples --workspace @kampuskit/backend",
    "collect:internships": "npm run collect:internships --workspace @kampuskit/backend",
    "collect:persist": "npm run collect:persist --workspace @kampuskit/backend",
    "demo:create": "npm run demo:create --workspace @kampuskit/backend",
    "test:integration": "npm run test:integration --workspace @kampuskit/backend",
    "edge:prepare": "npm run edge:prepare --workspace @kampuskit/backend"
  },
  "devDependencies": {
    "oxlint": "^1.81.0"
  }
}
