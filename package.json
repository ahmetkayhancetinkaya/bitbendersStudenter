{
  "name": "kampuskit-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "install:all": "npm --prefix backend ci && npm --prefix frontend ci",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build && npm --prefix backend run build && node scripts/prepare-hosting.mjs",
    "start": "npm --prefix backend start",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix frontend test && npm --prefix backend test",
    "contracts:check": "node scripts/check-contracts.mjs",
    "db:prepare": "npm --prefix backend run db:prepare",
    "seed:examples": "npm --prefix backend run seed:examples",
    "collect:internships": "npm --prefix backend run collect:internships",
    "collect:persist": "npm --prefix backend run collect:persist",
    "demo:create": "npm --prefix backend run demo:create",
    "test:integration": "npm --prefix backend run test:integration",
    "edge:prepare": "npm --prefix backend run edge:prepare"
  }
}
