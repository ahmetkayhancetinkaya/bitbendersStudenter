{
  "name": "hackathon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "db:prepare": "node scripts/prepare-database.mjs",
    "seed:examples": "node --env-file=.env.server.local scripts/seed-examples.mjs --run",
    "collect:internships": "node scripts/collect-internships.mjs",
    "collect:persist": "node --env-file=.env.server.local scripts/collect-internships.mjs --persist",
    "demo:create": "node --env-file=.env.server.local --env-file=.env.local scripts/create-demo-account.mjs --run",
    "test:integration": "node --env-file=.env.server.local --env-file=.env.local scripts/test-supabase.mjs --run",
    "edge:prepare": "node scripts/prepare-edge.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
